<?xml version="1.0" ?>
<Defs>
  <GeneDef ParentName="GeneHeadboneBase" Name="ERN_HornBase" Abstract="True">
    <description>Carriers of this gene have demon-like horns.</description>
    <displayCategory>ERN_CosmeticGenes</displayCategory>
  </GeneDef>

  <GeneDef ParentName="ERN_HornBase">
    <defName>ERN_BillieHorns</defName>
    <label>billie horns</label>
    <iconPath>UI/Icons/Genes/ERN_Cosmetic/BillieHorns</iconPath>
    <renderNodeProperties Inherit="False">
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Pawn/ERN_CosmeticGenes/Horns/BillieHorns</texPath>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <layer>10</layer>
            <offset>(0, 0, 0)</offset>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
          </dataEast>
        </drawData>
        <parentTagDef>Head</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

