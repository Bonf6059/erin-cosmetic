<Defs>
  <GeneDef ParentName="GeneEarsBase" Name="ERN_CosmeticEars" Abstract="True">
    <description>Carriers of this gene have animal-like ears.</description>
    <displayCategory>ERN_CosmeticGenes</displayCategory>
    <exclusionTags>
		  <li>Ears</li>
	  </exclusionTags>
    <symbolPack>
    </symbolPack>
    <modExtensions>
      <li Class="VEF.Genes.GeneExtension">
        <applySkinColorWithGenes>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrobearFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrocatFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrocowFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrodeerFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrodrakeSkin</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrofoxFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrogoatFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrogriffFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrohorseFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrohyenaFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthropandaFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrorabbitFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrosharkSkin</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrowahFur</li>
          <li MayRequire="ATK.Anthrosonae">ATK_AnthrowolfFur</li>
          <li MayRequire="Erin.Auraeyl">ERN_AuraeylBody</li>
        </applySkinColorWithGenes>
      </li>
    </modExtensions>  
  </GeneDef>

  <GeneDef ParentName="ERN_CosmeticEars">
    <defName>ERN_Ears_Bat</defName>
    <label>bat ears</label>
    <description>Carriers of this gene have bat-like ears.</description>
    <iconPath>UI/Icons/Genes/ERN_Cosmetic/BatEars</iconPath>
    <renderNodeProperties Inherit="False">
      <li>
        <texPath>Things/Pawn/ERN_CosmeticGenes/Ears/BatEars</texPath>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <shaderTypeDef>CutoutComplex</shaderTypeDef>
        <useSkinShader>false</useSkinShader>
        <colorType>Hair</colorType>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, -0.0002, 0)</offset>
            <layer>-5</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
          </dataEast>
        </drawData>
        <parentTagDef>Head</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

