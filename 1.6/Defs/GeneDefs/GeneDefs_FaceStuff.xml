<?xml version="1.0" ?>
<Defs>

  <GeneDef ParentName="GeneEarsBase" Name="ERN_FaceStuffBase" Abstract="True">
    <description>Carriers of this gene have demon-like horns.</description>
    <displayCategory>ERN_CosmeticGenes</displayCategory>    
    <exclusionTags>
		  <li>Ears</li>
	  </exclusionTags>
  </GeneDef>
  
  <GeneDef ParentName="ERN_FaceStuffBase">
    <defName>ERN_AxolotlFloof</defName>
    <label>axolotl floof</label>
    <description>Carriers of this gene grow axolotl-like frills on the side of their face.</description>
    <iconPath>UI/Icons/Genes/ERN_Cosmetic/AxolotlFloof</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <parentTagDef>Head</parentTagDef>
        <colorType>Skin</colorType>
        <useRottenColor>true</useRottenColor>
        <useSkinShader>true</useSkinShader>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <texPath>Things/Pawn/ERN_CosmeticGenes/FaceStuff/AxolotlFloof</texPath>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, -0.0002, 0)</offset>
            <layer>-5</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
          </dataEast>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

